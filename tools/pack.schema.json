{
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "level", "dialogues"],
  "properties": {
    "id": { "type": "string" },
    "level": { "type": "string", "enum": ["A1", "A2", "B1", "B2", "C1"] },
    "dialogues": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "situation", "turns"],
        "properties": {
          "title": { "type": "string" },
          "situation": { "type": "string" },
          "turns": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["speaker", "en", "vi"],
              "properties": {
                "speaker": { "type": "string", "enum": ["a", "b"] },
                "en": { "type": "string" },
                "vi": { "type": "string" }
              }
            }
          }
        }
      }
    }
  }
}
